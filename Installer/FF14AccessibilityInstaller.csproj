<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FF14AccessibilityInstaller-KR</AssemblyName>
    <!-- Eigene Installer-Version. Wird im Fenster angezeigt und beim Start gegen
         das Release-Asset "installer.json" im ff14-accessibility-Repo verglichen.
         Ist dort eine hoehere Version hinterlegt, aktualisiert sich der Installer
         nach Rueckfrage selbst (InstallerService.TrySelfUpdateAsync + SelfUpdate).
         MUSS beim Release mit dem Feld InstallerVersion in installer.json
         uebereinstimmen, sonst bietet der Installer das Update endlos erneut an. -->
    <Version>1.2.2.0</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <!-- Barrierefreiheit: WinForms-GUI. Standardcontrols (Label, TextBox, Button)
         setzen automatisch die klassischen Win32/UIA-Properties, NVDA/JAWS lesen
         sie ohne Zusatzaufwand vor. Status-Updates gehen zusaetzlich in ein
         fokussierbares, mehrzeiliges Log-Textfeld; wichtige Meldungen zusaetzlich
         per MessageBox (Standard-Win32-Dialog, wird automatisch vorgelesen). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Self-contained Single-File, damit Nutzer KEIN .NET installieren muessen:
         dotnet publish -c Release -r win-x64 erzeugt eine einzelne EXE. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Newtonsoft mit denselben Semantiken, die Dalamud fuer dalamudConfig.json
         nutzt ($type / TypeNameHandling). JObject bewahrt Property-Reihenfolge und
         die $type-Felder beim Round-Trip - System.Text.Json wuerde die Struktur
         gefaehrden. Fuer die reinen GitHub-/puni.sh-JSON-Antworten (ohne $type)
         wird dagegen System.Text.Json.Nodes verwendet (siehe InstallerService). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- KR fork: the launcher that starts the game and the Korean updater
         together, carried inside this EXE and written out during the install.

         Deliberately NOT conditional on the file existing. A missing launcher
         has to break the build here, at the one moment somebody is looking at
         it; made optional, it produces an installer that runs to completion and
         quietly puts down no shortcut. run\pack.bat publishes the Launcher
         project before this one for exactly that reason.

         The published file, not the built one: the launcher is
         framework-dependent, so its build output is an exe plus a dll plus a
         runtimeconfig, and only the single-file publish is one file to embed. -->
    <EmbeddedResource
      Include="..\Launcher\bin\Release\net10.0-windows\win-x64\publish\FF14AccessibilityPlay.exe"
      LogicalName="FF14AccessibilityPlay.exe" />
  </ItemGroup>

</Project>




